{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jointhefray.org/schemas/watchlist.v1.json",
  "title": "Fray watchlist v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "version", "published", "expires", "entries"],
  "properties": {
    "v": { "const": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "published": { "type": "string", "format": "date-time" },
    "expires": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "brand_terms", "authorized_domains"],
        "properties": {
          "domain": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          },
          "brand_terms": {
            "type": "array",
            "maxItems": 10,
            "items": { "type": "string", "minLength": 3, "maxLength": 60 }
          },
          "authorized_domains": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
            }
          },
          "policy": { "enum": ["open", "closed", "none"] },
          "authorized_advertiser_ids": {
            "type": "array",
            "maxItems": 1000,
            "items": { "type": "string", "pattern": "^AR[0-9]{1,62}$" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "policy": { "const": "none" } }, "required": ["policy"] },
            "then": { "properties": { "authorized_advertiser_ids": { "maxItems": 0 } } }
          }
        ]
      }
    }
  }
}
