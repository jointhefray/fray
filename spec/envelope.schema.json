{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jointhefray.org/schemas/envelope.json",
  "title": "Fray report envelope",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "watchlist_version",
        "brand",
        "platform",
        "surface",
        "observed_hour",
        "creative",
        "token"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "watchlist_version": {
          "type": "integer",
          "minimum": 1
        },
        "brand": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
        },
        "platform": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
        },
        "surface": {
          "enum": ["search", "feed"]
        },
        "observed_hour": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
        },
        "creative": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "body": {
              "type": "string",
              "maxLength": 1000
            },
            "display_url": {
              "type": "string",
              "maxLength": 300
            },
            "click_url": {
              "type": "string",
              "minLength": 12,
              "maxLength": 2048,
              "pattern": "^https://[^\\s]+$"
            },
            "advertiser_id": {
              "type": "string",
              "maxLength": 64
            },
            "advertiser_name": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "kid", "msg", "sig"],
          "properties": {
            "issuer": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
            },
            "kid": {
              "type": "string",
              "pattern": "^ep-\\d{4}-\\d{2}$"
            },
            "msg": {
              "type": "string",
              "minLength": 43,
              "maxLength": 45,
              "pattern": "^[A-Za-z0-9+/=_-]+$"
            },
            "sig": {
              "type": "string",
              "minLength": 300,
              "maxLength": 1400,
              "pattern": "^[A-Za-z0-9+/=_-]+$"
            }
          }
        }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "watchlist_version",
        "brand",
        "platform",
        "surface",
        "observed_hour",
        "observed_domain",
        "creative",
        "advertiser",
        "lookup",
        "token"
      ],
      "properties": {
        "v": {
          "const": 2
        },
        "watchlist_version": {
          "type": "integer",
          "minimum": 1
        },
        "brand": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
        },
        "platform": {
          "const": "google.com"
        },
        "surface": {
          "const": "search"
        },
        "observed_hour": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
        },
        "observed_domain": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
        },
        "creative": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["title"],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "body": {
                  "type": "string",
                  "maxLength": 1000
                },
                "display_url": {
                  "type": "string",
                  "maxLength": 300
                },
                "click_url": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 2048,
                  "pattern": "^https://[^\\s]+$"
                },
                "advertiser_id": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^AR[0-9]{1,62}$"
                },
                "advertiser_name": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "advertiser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^AR[0-9]{1,62}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
              "allOf": [
                {
                  "pattern": "\\S"
                }
              ]
            },
            "country": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
              "allOf": [
                {
                  "pattern": "\\S"
                }
              ]
            }
          }
        },
        "lookup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "batchCode", "atParameter"],
          "properties": {
            "kind": {
              "const": "google-batchexecute"
            },
            "batchCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8064,
              "pattern": "^[^\\u0000-\\u0020\\u007f]+$"
            },
            "atParameter": {
              "type": "string",
              "maxLength": 528,
              "pattern": "^[A-Za-z0-9_-]{10,512}(?::|%3[Aa])[0-9]{13}$"
            }
          }
        },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "kid", "msg", "sig"],
          "properties": {
            "issuer": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
            },
            "kid": {
              "type": "string",
              "pattern": "^ep-\\d{4}-(0[1-9]|1[0-2])$"
            },
            "msg": {
              "type": "string",
              "minLength": 43,
              "maxLength": 45,
              "pattern": "^[A-Za-z0-9+/=_-]+$"
            },
            "sig": {
              "type": "string",
              "minLength": 300,
              "maxLength": 1400,
              "pattern": "^[A-Za-z0-9+/=_-]+$"
            }
          }
        }
      }
    }
  }
}
