{
  "name": "@fray/token-issuer",
  "version": "0.1.0",
  "description": "Privacy token vending for Fray partners, using RFC 9474 blind RSA signatures",
  "license": "(MIT OR Apache-2.0)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/example.js",
    "dev": "node --import tsx src/example.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@cloudflare/blindrsa-ts": "^0.4.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
