HOST=0.0.0.0
PORT=8082
REDIS_URL=redis://localhost:6379

# Partner issuer allowlist: token.issuer name -> JWKS base URL, comma-separated.
ISSUERS=issuer.partner.example=https://issuer.partner.example

# Local copy of the published watchlist (kept current out of band).
WATCHLIST_PATH=./watchlist.sample.json

# Normative schema path; defaults to ../../spec/envelope.schema.json.
# ENVELOPE_SCHEMA_PATH=

# protocol.md §5 parameters — the defaults ARE the spec values.
QUORUM_K=3
SPENT_TTL_SECONDS=6048000
QUORUM_TTL_SECONDS=2592000
TRIAGE_SEEN_TTL_SECONDS=2592000
RAW_RETENTION_SECONDS=7776000
JWKS_TTL_MS=21600000
